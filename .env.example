# Скопируйте в .env и заполните три верхних значения:
#   cp .env.example .env
#
# Дальше всё поднимается одной командой:
#   docker compose up -d

# Домен, на который направлена A/AAAA-запись этого сервера.
# Caddy получит по нему сертификат Let's Encrypt автоматически.
DOMAIN=call.example.com

# Почта для Let's Encrypt: туда придут письма об истечении сертификата.
ACME_EMAIL=you@example.com

# Публичный адрес этой машины, а если она за NAT — пара «публичный/приватный».
# Облачные машины (GCP, AWS, Yandex Cloud) почти всегда видят только приватный
# адрес: без этой строки TURN раздаёт собеседникам его, и ретранслятор
# оказывается недостижим снаружи.
#   один адрес:      TURN_EXTERNAL_IP=203.0.113.7
#   машина за NAT:   TURN_EXTERNAL_IP=203.0.113.7/10.129.0.36
TURN_EXTERNAL_IP=

# Общий секрет между сигналингом и coturn. Клиенту не отдаётся никогда —
# сервер выдаёт по нему временные логин и пароль.
# Сгенерировать:  openssl rand -hex 32
TURN_SECRET=

# --- дальше можно ничего не трогать ---

# Порт TURN. 3478 — стандартный для turn:
TURN_PORT=3478

# Диапазон портов, через которые TURN раздаёт медиа.
# 40 портов хватает примерно на 20 одновременных ретранслируемых звонков.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Сколько живут выданные учётные данные TURN, секунды.
TURN_CREDENTIAL_TTL=3600

# Потолок одновременных комнат и время жизни опустевшей комнаты.
MAX_ROOMS=500
ROOM_TTL_SECONDS=600
